[Unit]
Description=Check public job boards and send private Telegram alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/career-watcher
EnvironmentFile=%h/.config/career-watcher.env
ExecStart=/usr/bin/python3 -m jobwatcher.app run --config config/companies.json --db data/career-watcher.sqlite3
